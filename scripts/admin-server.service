[Unit]
Description=Remote Web Admin Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/admin-server
ExecStart=/usr/bin/node /opt/admin-server/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=4000
Environment=HOST=0.0.0.0

# Security sandboxing
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
