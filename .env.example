# Configuration du Serveur d'Administration Distante
PORT=4000
HOST=0.0.0.0

# Identifiants de connexion Web
ADMIN_USER=admin
ADMIN_PASSWORD=adminpassword123

# Clé secrète JWT (générée automatiquement si absente)
JWT_SECRET=super_secret_jwt_key_remote_admin_change_in_production

# Durée de validité de la session
SESSION_TIMEOUT=24h

# Activer l'explorateur de fichiers (true / false)
ALLOW_FILE_EXPLORER=true
